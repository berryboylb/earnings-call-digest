# Copy to .env and fill in. .env is gitignored.

# API key from build.nvidia.com
NVIDIA_API_KEY=
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_MODEL_FALLBACK=openai/gpt-oss-20b
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=

# Optional
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_REASONING_EFFORT=
# Seconds to wait for one answer before trying the next model (default 600)
LLM_TIMEOUT_SECONDS=600
# Most tokens one answer may use, hidden reasoning included (default 16384)
LLM_MAX_TOKENS=16384
