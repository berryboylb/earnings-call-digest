# Copy to .env and fill in. .env is gitignored.

# API key from build.nvidia.com
NVIDIA_API_KEY=

# Required, no default: the exact model ID from the model's page on build.nvidia.com
LLM_MODEL=

# Optional: models to try, in order, if a call to LLM_MODEL fails (rate limit, outage,
# unusable output). Comma-separated. They use the primary endpoint and key unless the
# two settings below are set (e.g. for a fallback hosted by another provider).
LLM_MODEL_FALLBACK=
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_API_KEY=

# Optional
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_REASONING_EFFORT=
